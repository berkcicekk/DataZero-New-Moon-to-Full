# Copy to .env and edit. .env is gitignored — nothing here belongs in the repo.

# ─── Your local DataZero profile ─────────────────────────────────────────────
# These three values are the private witness. They are read into the circuit on
# your machine, proved against the campaign criteria, and discarded. They are
# never written to the ledger and never sent to the proof server in plaintext.

# 1 = 18-24, 2 = 25-34, 3 = 35-44, 4 = 45-54, 5 = 55-64, 6 = 65+
DATAZERO_AGE_BRACKET=3
# Interest category, up to 32 bytes.
DATAZERO_INTEREST=travel
# How actively you engage with that category, 0-10000.
DATAZERO_ENGAGEMENT=7200

# ─── Wallet ──────────────────────────────────────────────────────────────────
# Leave both unset and `npm run deploy` generates a wallet for you and saves the
# recovery phrase to .midnight-state.json (gitignored). Set exactly one of them
# to reuse an existing wallet — never both.
# MIDNIGHT_WALLET_MNEMONIC="word word word ..."
# MIDNIGHT_WALLET_SEED=

# ─── Private-state store ─────────────────────────────────────────────────────
# Encrypts the local private-state database. Minimum 16 characters. Required for
# anything beyond a local devnet.
# PRIVATE_STATE_PASSWORD=

# ─── Endpoint overrides (optional) ───────────────────────────────────────────
# MIDNIGHT_INDEXER_URL=
# MIDNIGHT_INDEXER_WS_URL=
# MIDNIGHT_NODE_URL=
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
